{
  "schema": "pushkalavati.meta-grammar/1",
  "principle": "Functional categories are overlapping labels, not sequential execution phases. Rules are data records; this table defines category semantics and classification predicates.",
  "categories": [
    {
      "id": "combine",
      "traditional_label": "Sandhi",
      "meaning": "Join or coalesce adjacent sounds, morphemes, or forms."
    },
    {
      "id": "split",
      "traditional_label": "Viccheda / Padaccheda",
      "meaning": "Recover boundaries and candidate underlying forms; permit ambiguity."
    },
    {
      "id": "substitute",
      "traditional_label": "Ādeśa",
      "meaning": "Replace a target with another representation."
    },
    {
      "id": "insert",
      "traditional_label": "Āgama",
      "meaning": "Insert an element at a defined site."
    },
    {
      "id": "delete",
      "traditional_label": "Lopa",
      "meaning": "Remove or suppress an element under conditions."
    },
    {
      "id": "affix",
      "traditional_label": "Pratyaya",
      "meaning": "Select or attach a grammatical affix."
    },
    {
      "id": "transform",
      "traditional_label": "Vikāra / transformation",
      "meaning": "Change internal phonological or morphological structure."
    },
    {
      "id": "derive",
      "traditional_label": "Derivation / inflection",
      "meaning": "Construct words or inflected forms from grammatical inputs."
    },
    {
      "id": "relate",
      "traditional_label": "Kāraka / Vibhakti / Anvaya",
      "meaning": "Establish relations between constituents."
    },
    {
      "id": "constrain",
      "traditional_label": "Niyama / Pratiṣedha",
      "meaning": "Restrict, license, qualify, or prohibit operations."
    },
    {
      "id": "define",
      "traditional_label": "Saṃjñā",
      "meaning": "Define a technical category or label."
    },
    {
      "id": "scope_inherit",
      "traditional_label": "Adhikāra / Anuvṛtti",
      "meaning": "Establish scope or inherited conditions."
    },
    {
      "id": "override",
      "traditional_label": "Apavāda / Utsarga / Vipratiṣedha",
      "meaning": "Represent exceptions and competing-rule resolution."
    },
    {
      "id": "transfer",
      "traditional_label": "Atideśa",
      "meaning": "Transfer a property or operation across grammatical contexts."
    },
    {
      "id": "interpret",
      "traditional_label": "Paribhāṣā",
      "meaning": "Govern interpretation or application of grammatical rules."
    }
  ],
